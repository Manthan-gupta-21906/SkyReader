# SkyReader Environment Configuration Example
# Copy this file to .env to customize local development settings

# Application Metadata
VITE_APP_NAME="SkyReader"
VITE_APP_DESCRIPTION="In-browser cloud classification and intelligent outdoor guidance"

# Open-Meteo Weather APIs (No API key required)
VITE_API_WEATHER_BASE_URL="https://api.open-meteo.com/v1"
VITE_API_GEOCODING_BASE_URL="https://geocoding-api.open-meteo.com/v1"

# Network Request Settings
VITE_API_TIMEOUT_MS=8000
VITE_API_MAX_RETRIES=2

# Feature Flags & Fallbacks
VITE_ENABLE_MOCK_FALLBACK=true
