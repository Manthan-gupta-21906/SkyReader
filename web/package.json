    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^24.0.0",
    "oxlint": "^1.81.0",
    "prettier": "^3.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
